{
  "name": "lostlink",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lostlink",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "services/api-gateway",
        "services/identity-service",
        "services/lost-found-service",
        "services/matching-service",
        "packages/*"
      ],
      "engines": {
        "node": "24.19.0",
        "npm": "11.17.0"
      }
    },
    "node_modules/@lostlink/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "packages/contracts": {
      "name": "@lostlink/contracts",
      "version": "0.0.0"
    }
  }
}
